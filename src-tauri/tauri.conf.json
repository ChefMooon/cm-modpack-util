{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CM Modpack Util",
  "version": "0.0.14",
  "identifier": "com.cm.modpackutil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "CM Modpack Util",
        "width": 800,
        "height": 600,
        "visible": false,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MDk0M0RCMDNDOTg4RjIKUldUeWlNa0QyME1KaDFzYkNUazV0VXYvTVlFN2VQS1JoN3orNVRqVUZyOXZaQUVNeU5jZW9TWEoK",
      "endpoints": [
        "https://github.com/ChefMooon/cm-modpack-util/releases/latest/download/latest.json"
      ]
    }
  }
}
